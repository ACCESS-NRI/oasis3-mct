<?xml version="1.0"?>

<simulation>

  <context id="toy">
    <variable_definition>
<!--  Path of the grid definition NetCDF files -->
      <variable id="grids_input_file"> /scratch/globc/valcke/oasis3-mct/examples/regrid_environment/OASIS/grids.nc </variable>
      <variable id="masks_input_file"> /scratch/globc/valcke/oasis3-mct/examples/regrid_environment/OASIS/masks.nc </variable>
      <variable id="areas_input_file"> /scratch/globc/valcke/oasis3-mct_other/compare_interpolations/grids_compare/areas.nc </variable>

<!--  Choose src and tgt domain between nogt torc bggd icos icoh ssea -->
      <variable id="src_domain"> bggd </variable>
      <variable id="tgt_domain"> nogt </variable>

<!--  2D field academic for analytical fct, rank for parallel decomposition, genmask for mask generation -->
      <variable id="init_field2D"> one </variable>
<!--  Analytical Gulf stream weigth (set to 0.0 for the smooth fct only -->
      <variable id="gulf_stream_coeff"> 0.0 </variable>

<!--  ** src XIOS generated domains ** -->
      
<!--  <variable id="src_domain_mask"> false </variable> -->
<!--  <variable id="src_domain"> nemo </variable>
      <variable id="src_ni"> 1442 </variable>
      <variable id="src_nj"> 1021 </variable> -->
<!--  <variable id="src_domain"> lmdz </variable>
      <variable id="src_ni"> 36 </variable>
      <variable id="src_nj"> 18 </variable> -->      
<!--  <variable id="src_domain"> gaussian </variable>
      <variable id="src_ni"> 360 </variable>
      <variable id="src_nj"> 180 </variable> -->

<!--  ** tgt XIOS generated domains ** -->
      
<!--  <variable id="tgt_domain_mask"> false </variable> -->
<!--  <variable id="tgt_domain"> gaussian </variable>
      <variable id="tgt_ni"> 360 </variable>
      <variable id="tgt_nj"> 180 </variable> -->
<!--  <variable id="tgt_domain"> nemo </variable>
      <variable id="tgt_ni"> 1442 </variable>
      <variable id="tgt_nj"> 1021 </variable> -->
<!--  <variable id="tgt_domain"> lmdz </variable>
      <variable id="tgt_ni"> 720 </variable>
      <variable id="tgt_nj"> 360 </variable> -->

      <variable id="timestep"> 1h </variable>

    </variable_definition>
  </context>



  <context id="toy" src="./context_toy.xml"/>
  
  <context id="xios">
    <variable_definition>
      <variable_group id="buffer">
  <variable id="min_buffer_size" type="int">10000000</variable>
  <variable id="optimal_buffer_size" type="string">memory</variable>
  <variable id="buffer_factor_size" type="double">0.8</variable> 
      </variable_group>

      <variable_group id="parameters" >
        <variable id="using_server" type="bool">false</variable>
        <variable id="info_level" type="int">100</variable>
        <variable id="print_file" type="bool">true</variable>
        <variable id="using_server2" type="bool">false</variable>
        <variable id="ratio_server2" type="int">50</variable>
        <variable id="number_pools_server2" type="int">1</variable>
        <variable id="pure_one_sided" type="bool">false</variable>
        <variable id="check_event_sync" type="bool">true</variable>
      </variable_group>
      <variable id="activate_non_distributed_transformation" type="bool">true</variable>
    </variable_definition>
  </context>

</simulation>
