#!/bin/ksh
#set -x
srcdir=`pwd`
n_p_t=$1
ext=$2
library=SCRP
casename=`basename $srcdir`
for SGRID in bggd ; do
   for TGRID in nogt torc ; do
       for remap in distwgt bili bicu conserv1st conserv2nd ; do
	   ./run_regrid.sh $SGRID $TGRID $remap $n_p_t $library $ext
       done
   done
done
for SGRID in sse7 ; do
   for TGRID in nogt torc ; do
       for remap in distwgt bili bicu conserv1st ; do
	   ./run_regrid.sh $SGRID $TGRID $remap $n_p_t $library $ext
       done
   done
done
for SGRID in icos ; do
   for TGRID in nogt torc ; do
       for remap in distwgt conserv1st ; do
           ./run_regrid.sh $SGRID $TGRID $remap $n_p_t $library $ext
       done
   done
done
for SGRID in nogt torc ; do
   for TGRID in bggd sse7 icos ; do
       for remap in distwgt bili bicu conserv1st conserv2nd ; do
           ./run_regrid.sh $SGRID $TGRID $remap $n_p_t $library $ext
       done
   done
done
