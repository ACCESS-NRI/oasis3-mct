#!/bin/ksh
#set -x
srcdir=`pwd`
n_p_t=$1
library=$2
ext=$3
casename=`basename $srcdir`
for SRC_GRID in bggd icos ssea ; do
   TGT_GRID=nogt
   for remap in distwgt conserv1st ; do
       ./run_regrid.sh $SRC_GRID $TGT_GRID $remap $n_p_t $library $ext
   done
done
for SRC_GRID in bggd ssea ; do
   TGT_GRID=nogt
   for remap in bili bicu ; do
        ./run_regrid.sh $SRC_GRID $TGT_GRID $remap $n_p_t $library $ext
   done
done 
SRC_GRID=bggd
TGT_GRID=nogt
remap=conserv2nd
./run_regrid.sh $SRC_GRID $TGT_GRID $remap $n_p_t $library $ext
