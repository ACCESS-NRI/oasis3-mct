#
# Include file for OASIS3 Makefile for a Linux system using 
# Portland Group Fortran Compiler and MPICH
#  Dans .bashrc
#  module load openmpi/410_gcc1020
#  module load lib/netcdf-fortran/4.4.4_gcc1020
#  module load python/3.7.7
#
###############################################################################
#
# CHAN	: communication technique used in OASIS3 (MPI1/MPI2)
CHAN            = MPI1
#
# Paths for libraries, object files and binaries
#
# COUPLE        : path for oasis3-mct main directory
COUPLE          := $(OASIS_COUPLE)
#
# ARCHDIR       : directory created when compiling
ARCHDIR         := $(COUPLE)/INSTALL_OASIS.$(OASIS_ENV)
#
# MPI library
MPIDIR      = /usr/local/openmpi/4.1.0_gcc1020
MPIBIN      = $(MPIDIR)/bin
MPI_INCLUDE = $(MPIDIR)/include
MPILIB      = -L$(MPIDIR)/lib -lmpi
MPIRUN      = $(MPIBIN)/mpirun --oversubscribe
#
# NETCDF library of the system
NETCDF_INCLUDE = /usr/local/netcdf-fortran/4.4.4_gcc1020/include
NETCDF_LIBRARY = -L/usr/local/netcdf-fortran/4.4.4_gcc1020/lib -Wl,-rpath,/usr/local/netcdf-fortran/4.4.4_gcc1020/lib -lnetcdff -lnetcdf -lm
#
# YAC libraries
YAXT_ROOT = $(OASIS_COUPLE)/../INSTALL/yaxt
YAC_ROOT  = $(OASIS_COUPLE)/../INSTALL/yac-v3.1.0
YAC_INCLUDE = -I$(YAC_ROOT)/include -I$(YAXT_ROOT)/include
YAC_LIBRARY = -L $(YAC_ROOT)/lib \
              -L $(YAXT_ROOT)/lib -Wl,-rpath,$(YAXT_ROOT)/lib \
              -lyac_utils -lyac_core -lyaxt_c
#
# LAPACK libraries
LAPACK_LIBRARY = -llapack -lblas
#
# Compiling and other commands
MAKE        = gmake
F90         = $(MPIBIN)/mpif90 -I$(MPI_INCLUDE)
F           = $(F90)
f90         = $(F90)
f           = $(F90)
CC          = $(MPIBIN)/mpicc -I$(MPI_INCLUDE)
LD          = $(MPIBIN)/mpif90 $(MPILIB)
DYNOPT      = -fPIC
LDDYNOPT    = -shared
AR          = ar
ARFLAGS     = -ruv
# Fortran libraries for C linking
F2C_LIBS    = -lmpi_mpifh -lgfortran -lm
#
# CPP keys and compiler options
#  
CPPDEF    = -Duse_comm_$(CHAN) -D__VERBOSE -DTREAT_OVERLAY -DYAC_REMAP
#
FCBASEFLAGS := -fallow-argument-mismatch -ffree-line-length-0 
ifeq ($(OASIS_DEBUG), )
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS += -O2
	else
		FCBASEFLAGS += -O2 -fopenmp
	endif
else
	ifeq ($(OASIS_OPENMP), )
                FCBASEFLAGS += -g -fbounds-check
        else
                FCBASEFLAGS += -g -fbounds-check -fopenmp
        endif
endif
CCBASEFLAGS  := 
ifeq ($(OASIS_OPENMP), )
	CCBASEFLAGS  +=
else
	CCBASEFLAGS  += -fopenmp
endif
#
# INC_DIR : includes all *mod for each library
INC_DIR = -I$(ARCHDIR)/include
# FLIBS : for toys when linking in local Makefile
FLIBS = $(YAC_LIBRARY) $(NETCDF_LIBRARY) $(LAPACK_LIBRARY)
#
F90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
f90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
FFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
fFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
CCFLAGS     = $(CCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
LDFLAGS     = $(FCBASEFLAGS)
F2C_LDFLAGS = $(F2C_LIBS)
#
#############################################################################
