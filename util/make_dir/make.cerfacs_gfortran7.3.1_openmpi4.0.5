#
# Include file for OASIS3 Makefile for a Linux system using
# Gnu compilers and OpenMPI
# To use this, 
# module purge
# module load mpi/openmpi/405_gcc731
# module load python/3.7.7
#
###############################################################################
#
# CHAN	: communication technique used in OASIS3 (MPI1/MPI2)
CHAN            = MPI1
#
# Paths for libraries, object files and binaries
#
# COUPLE	: path for oasis3-mct main directory
COUPLE          = $(OASIS_COUPLE)
#
# ARCHDIR       : directory created when compiling
ARCHDIR         = $(COUPLE)/INSTALL_OASIS.$(OASIS_ENV)
#
# MPI command (for pyoasis scripts)
# MPI from /softs/local/openmpi405_gcc731/bin/mpirun by module load mpi/openmpi/405_gcc731
MPIRUN      = mpirun --oversubscribe
#
# NETCDF library
NETCDF_INCLUDE = /usr/include
NETCDF_MOD     = /usr/lib64/gfortran/modules
NETCDF_LIBRARY = -L/usr/lib64 -lnetcdff -lnetcdf
#
# YAC libraries
YAXT_ROOT = $(ARCHDIR)/lib/yaxt
YAC_ROOT = $(ARCHDIR)/lib/yac
YAC_INCLUDE = -I$(YAC_ROOT)/include -I$(YAXT_ROOT)/include
YAC_LIBRARY = -L $(YAC_ROOT)/lib \
              -L $(YAXT_ROOT)/lib -Wl,-rpath,$(YAXT_ROOT)/lib \
              -lyac_utils -lyac_core -lyaxt_c
#
# Make command
MAKE        = gmake
# Compilers
F90         = mpifort # underlying gfortran from module load mpi/openmpi/405_gcc731
F           = $(F90)
f90         = $(F90)
f           = $(F90)
CC          = mpicc
# Linker (needed for shared libraries)
LD          = $(F90)
# Shared libraries options
DYNOPT      = -fPIC
LDDYNOPT    = -shared
# Static archiver
AR          = ar
ARFLAGS     = -ruv
#
# CPP keys and compiler options
#
CPPDEF    = -Duse_comm_$(CHAN) -D__VERBOSE -DTREAT_OVERLAY
#
FCBASEFLAGS  := -ffree-line-length-512
CCBASEFLAGS  :=
ifeq ($(OASIS_DEBUG), )
	FCBASEFLAGS  += -O2
	CCBASEFLAGS  += -O2
else
	FCBASEFLAGS  += -g -fbounds-check
	CCBASEFLAGS  +=
endif
#
# INC_DIR : includes all *mod for each library
INC_DIR = -I$(ARCHDIR)/include
# FLIBS : for toys when linking in local Makefile
FLIBS = $(YAC_LIBRARY) $(NETCDF_LIBRARY)
#
F90FLAGS = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) -I$(NETCDF_MOD) $(YAC_INCLUDE)
f90FLAGS = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) -I$(NETCDF_MOD) $(YAC_INCLUDE)
FFLAGS   = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) -I$(NETCDF_MOD) $(YAC_INCLUDE)
fFLAGS   = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) -I$(NETCDF_MOD) $(YAC_INCLUDE)
CCFLAGS  = $(CCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) -I$(NETCDF_MOD) $(YAC_INCLUDE)
LDFLAGS  = $(FCBASEFLAGS)
F2C_LDFLAGS = -lmpi_mpifh -lgfortran -lm
#
#############################################################################
