#
# Include file for OASIS3 Makefile
# for Portland Group Fortran compiler and OpenMPI on a Linux system
# To use this,
# module purge
# module load pgi/20.4
# module load pgimpi/openmpi3.1.3_pgi20
# module load lib/netcdf-c/4.6.1_pgi20.4
# module load lib/netcdf-fortran/4.4.4_pgi20.4
# module load python/3.7.7
#
###############################################################################
#
# CHAN	: communication technique used in OASIS3 (MPI1/MPI2)
CHAN            = MPI1
#
# Paths for libraries, object files and binaries
#
# COUPLE	: path for oasis3-mct main directory
COUPLE         := $(OASIS_COUPLE)
#
# ARCHDIR       : directory created when compiling
ARCHDIR        := $(COUPLE)/INSTALL_OASIS.$(OASIS_ENV)
#
# ENABLE_YAC    : activate YAC based remapping libraries
ENABLE_YAC      = YES
#
# MPI library
MPIDIR      = /usr/local/pgi/linux86-64/20.4/mpi/openmpi-3.1.3
MPIBIN      = $(MPIDIR)/bin
MPI_INCLUDE = $(MPIDIR)/include
MPILIB      = -L$(MPIDIR)/lib
MPIRUN      = $(MPIBIN)/mpirun --oversubscribe
#
# NETCDF library
NETCDF_DIR     = /usr/local/netcdf-fortran/4.4.4_pgi20.4
NETCDF_INCLUDE = $(NETCDF_DIR)/include
NETCDF_LIBRARY = -L$(NETCDF_DIR)/lib -lnetcdff -L/usr/local/netcdf-c/4.6.1_pgi20.4/lib -lnetcdf -Wl,-rpath,$(NETCDF_DIR)/lib -Wl,-rpath,/usr/local/netcdf-c/4.6.1_pgi20.4/lib
#
# LAPACK libraries
LAPACK_LIBRARY = -llapack -lblas
#
# Make command
MAKE        = gmake
# Compilers
F90         = $(MPIBIN)/mpif90 -I$(MPI_INCLUDE) 
F           = $(F90)
f90         = $(F90)
f           = $(F90)
CC          = $(MPIBIN)/mpicc -I$(MPI_INCLUDE) -pgf90libs
# YAC compiler and options
YCC = $(MPIBIN)/mpicc
YFC = $(MPIBIN)/mpif90
ifeq ($(OASIS_DEBUG), )
# optimisation safe
YCFLAGS  = -O2
YFCFLAGS = -O2
else
# optimisation debug
YCFLAGS  = -O0 -g
YFCFLAGS = -O0 -g
endif
YAXTCONF = --without-regard-for-quality
#
# YAC libraries options for models and toys link
# Leave empty if YAC not enabled
ifeq ($(ENABLE_YAC),YES)
YAC_LIBRARY = -L$(ARCHDIR)/lib -Wl,-rpath,$(ARCHDIR)/lib \
              -lyac_utils -lyac_core -lyaxt_c -llapack -lblas
endif
# Static archiver
AR          = ar
ARFLAGS     = -ruv
# Linker (needed for shared libraries)
LD          = $(MPIBIN)/mpif90 $(MPILIB)
# Shared libraries options
DYNOPT      = -fPIC
LDDYNOPT    = -shared
# Fortran libraries for C linking
F2C_LIBS    =
#
# CPP keys and compiler options
#
CPPDEF    = -Duse_comm_$(CHAN) -D__VERBOSE -DTREAT_OVERLAY -D__NO_16BYTE_REALS
#
# -g is necessary in F90FLAGS and LDFLAGS for pgf90 versions lower than 6.1
#
FCBASEFLAGS :=
CCBASEFLAGS :=
ifeq ($(OASIS_DEBUG), )
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS +=
	else
		FCBASEFLAGS += -mp -lpthread
		CCBASEFLAGS += -mp
	endif
else
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS += -C -g -Mbounds -byteswapio
	else
		FCBASEFLAGS += -C -g -Mbounds -byteswapio -mp -lpthread
		CCBASEFLAGS += -mp
	endif
endif
#
# INC_DIR : includes all *mod for each library
INC_DIR = -I$(ARCHDIR)/include
# FLIBS : for toys when linking in local Makefile
FLIBS = $(YAC_LIBRARY) $(NETCDF_LIBRARY) $(LAPACK_LIBRARY)
#
F90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE)
f90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE)
FFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE)
fFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE)
CCFLAGS     = $(CCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE)
LDFLAGS     = $(FCBASEFLAGS)
F2C_LDFLAGS = $(F2C_LIBS)
#
#############################################################################
