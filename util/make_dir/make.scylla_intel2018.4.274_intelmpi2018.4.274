#
# Include file for OASIS3 Makefile 
# more /data/softs/modulefiles/mpi/intelmpi/2018.4.274
# module load compiler/intel/18.0.5.274
# module load mpi/intelmpi/2018.4.274 
# module load lib/netcdf-fortran/4.4.4 lib/hdf5/1.8.20_intel
# module load python/3.7.7 if pyoasis
#
###############################################################################
#
# CHAN	: communication technique used in OASIS3 (MPI1/MPI2)
CHAN            = MPI1
#
# Paths for libraries, object files and binaries
#
# COUPLE	: path for oasis3-mct main directory
COUPLE          := $(OASIS_COUPLE)
#
# ARCHDIR       : directory created when compiling
ARCHDIR         := $(COUPLE)/INSTALL_OASIS.$(OASIS_ENV)
#
# MPI library
MPIDIR           = /data/softs/intel/impi/2018.4.274
MPIBIN           = $(MPIDIR)/bin64
MPI_INCLUDE      = $(MPIDIR)/include64
MPILIB           = -L$(MPIDIR)/lib64
MPIRUN           = $(MPIBIN)/mpirun --oversubscribe
#
# NETCDF library
NETCDF_DIR     = /data/softs/local_intel/netcdf-fortran/4.4.4
NETCDF_INCLUDE = $(NETCDF_DIR)/include
NETCDF_LIBRARY = -Wl,-rpath,$(NETCDF_DIR)/lib -L$(NETCDF_DIR)/lib -lnetcdff -lnetcdf
#
# YAC libraries
YAXT_ROOT = $(ARCHDIR)/lib/yaxt
YAC_ROOT  = $(ARCHDIR)/lib/yac
YAC_INCLUDE = -I$(YAC_ROOT)/include -I$(YAXT_ROOT)/include
YAC_LIBRARY = -L $(YAC_ROOT)/lib \
              -L $(YAXT_ROOT)/lib -Wl,-rpath,$(YAXT_ROOT)/lib \
              -lyac_utils -lyac_core -lyaxt_c
#
# Compiling and other commands
MAKE        = gmake
F90         = $(MPIBIN)/mpiifort 
F           = $(F90)
f90         = $(F90)
f           = $(F90)
CC          = $(MPIBIN)/mpiicc 
LD          = $(MPIBIN)/mpiifort
# Static libraries compilation options
ifeq ($(OASIS_DEBUG), )
      STATOPT     = -march=core-avx2
else
      STATOPT     =
endif
# Shared libraries options
DYNOPT      = -fPIC
LDDYNOPT    = -shared
AR          = ar
ARFLAGS     = -ruv
# Fortran libraries for C linking
F2C_LIBS    = -lifcore -lifcoremt -lifport -limf
#
# CPP keys and compiler options
# 
CPPDEF    = -Duse_netCDF -Duse_comm_$(CHAN) -D__VERBOSE  -DTREAT_OVERLAY
#
# -g is necessary in F90FLAGS and LDFLAGS for pgf90 versions lower than 6.1
# 
FCBASEFLAGS := -I. -assume byterecl -mkl
ifeq ($(OASIS_DEBUG), )
	ifeq ($(OASIS_OPENMP), )	
		FCBASEFLAGS += -O2 -march=core-avx2
	else
		FCBASEFLAGS += -O2 -march=core-avx2 -qopenmp
	endif
else
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS += -g -traceback -check all -check noarg_temp_created
	else
		FCBASEFLAGS += -g -traceback -check all -check noarg_temp_created -qopenmp
endif
CCBASEFLAGS :=
ifeq ($(OASIS_OPENMP), )
	CCBASEFLAGS  += -qopenmp
endif
#
# INC_DIR : includes all *mod for each library
INC_DIR = -I$(ARCHDIR)/include
# FLIBS : for toys when linking in local Makefile
FLIBS = $(YAC_LIBRARY) $(NETCDF_LIBRARY)
#
F90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
f90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
FFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
fFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
CCFLAGS     = $(CCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
LDFLAGS     = $(FCBASEFLAGS)
F2C_LDFLAGS = $(F2C_LIBS)
#
#############################################################################
