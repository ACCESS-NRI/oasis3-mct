#
# Include file for OASIS3 Makefile for nemo lenovo at Cerfacs with OpenMP
# module load compiler/intel/18.0.1.163
# module load mpi/intelmpi/2018.1.163
# module load lib/netcdf-fortran/4.4.4_impi
# module load lib/phdf5/1.8.20_impi
#
###############################################################################
#
# CHAN	: communication technique used in OASIS3 (MPI1/MPI2)
CHAN            = MPI1
#
# Paths for libraries, object files and binaries
#
# COUPLE	: path for oasis3-mct main directory
COUPLE          := $(OASIS_COUPLE)
#
# ARCHDIR       : directory created when compiling
ARCHDIR         := $(COUPLE)/INSTALL_OASIS.$(OASIS_ENV)
#
# MPI library
#MPIDIR           = ${MPICOMPILER}
MPIDIR           = /softs/intel/impi/2018.1.163
MPIBIN           = $(MPIDIR)/bin64
MPI_INCLUDE      = $(MPIDIR)/include64
MPILIB           = -L$(MPIDIR)/lib64
MPIRUN           = $(MPIBIN)/mpirun
#
# NETCDF library
NETCDF_DIR     = /softs/local_intel/netcdf-fortran/4.4.4_phdf5
NETCDF_LIBDIR1 = $(NETCDF_DIR)/lib
NETCDF_LIBDIR2 = /softs/local_intel/netcdf-c/4.6.1_phdf5/lib
NETCDF_INCDIR1 = $(NETCDF_DIR)/include
NETCDF_INCDIR2 = /softs/local_intel/netcdf-c/4.6.1_phdf5/include
NETCDF_LIBRARY = -Wl,-rpath,$(NETCDF_LIBDIR1) -L$(NETCDF_LIBDIR1) -Wl,-rpath,$(NETCDF_LIBDIR2) -L$(NETCDF_LIBDIR2) -lnetcdff -lnetcdf
#
# YAC libraries
YAXT_ROOT = $(ARCHDIR)/lib/yaxt
YAC_ROOT  = $(ARCHDIR)/lib/yac
YAC_INCLUDE = -I$(YAC_ROOT)/include -I$(YAXT_ROOT)/include
YAC_LIBRARY = -L $(YAC_ROOT)/lib \
              -L $(YAXT_ROOT)/lib -Wl,-rpath,$(YAXT_ROOT)/lib \
              -lyac_utils -lyac_core -lyaxt_c
#
# Compiling and other commands
MAKE        = gmake
F90         = $(MPIBIN)/mpiifort -I$(MPI_INCLUDE)
F           = $(F90)
f90         = $(F90)
f           = $(F90)
CC          = $(MPIBIN)/mpiicc -I$(MPI_INCLUDE)
LD          = $(MPIBIN)/mpiifort $(MPILIB)
DYNOPT      = -fPIC
LDDYNOPT    = -shared
AR          = ar
ARFLAGS     = -ruv
# Fortran libraries for C linking
F2C_LIBS    = -lifcore -lifcoremt -lifport -limf
#
# CPP keys and compiler options
# 
CPPDEF    = -Duse_netCDF -Duse_comm_$(CHAN) -D__VERBOSE  -DTREAT_OVERLAY -DYAC_REMAP
#
# -g is necessary in F90FLAGS and LDFLAGS for pgf90 versions lower than 6.1
# 
FCBASEFLAGS := -I. -assume byterecl -mkl
CCBASEFLAGS :=
ifeq ($(OASIS_DEBUG), )
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS += -O2 -xCORE-AVX2
	else
		FCBASEFLAGS += -O2 -xCORE-AVX2 -mt_mpi -qopenmp
                CCBASEFLAGS += -qopenmp
	endif
else
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS  += -g -traceback -fpe0 -check all -check noarg_temp_created
        else
		FCBASEFLAGS  += -g -traceback -fpe0 -check all -check noarg_temp_created -mt_mpi -qopenmp
		CCBASEFLAGS  += -qopenmp
        endif
endif
#
# YAC compiler and options
YCC = $(MPIBIN)/mpiicc
YFC = $(MPIBIN)/mpiifort
# optimisation safe
YCFLAGS  = -O2 -fp-model precise
YFCFLAGS = -O2 -fp-model precise
# optimisation top
#YCFLAGS  = -O3 -xCORE-AVX2 -fp-model precise
#YFCFLAGS = -O3 -xCORE-AVX2 -fp-model precise
# optimisation debug
#YCFLAGS  = -O0 -g -traceback
#YFCFLAGS = -O0 -g -traceback
#
# INC_DIR : includes all *mod for each library
INC_DIR = -I$(ARCHDIR)/include
# FLIBS : for toys when linking in local Makefile
FLIBS = $(YAC_LIBRARY) $(NETCDF_LIBRARY)
#
F90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCDIR1) -I$(NETCDF_INCDIR2) $(YAC_INCLUDE)
f90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCDIR1) -I$(NETCDF_INCDIR2) $(YAC_INCLUDE)
FFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCDIR1) -I$(NETCDF_INCDIR2) $(YAC_INCLUDE)
fFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCDIR1) -I$(NETCDF_INCDIR2) $(YAC_INCLUDE)
CCFLAGS     = $(CCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCDIR1) -I$(NETCDF_INCDIR2) $(YAC_INCLUDE)
LDFLAGS     = $(FCBASEFLAGS)
F2C_LDFLAGS = $(F2C_LIBS)
#
#############################################################################
