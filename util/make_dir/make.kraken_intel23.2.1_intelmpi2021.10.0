#
# Include file for OASIS3 Makefile for Intel 23 on
# kraken at Cerfacs with OpenMP
# module load compiler/intel/23.2.1
# module load mpi/intelmpi/2021.10.0
# module load lib/phdf5/1.10.4_impi
# module load lib/netcdf-fortran/4.4.4_phdf5_1.10.4
# module load python/3.7.7
#
###############################################################################
#
# CHAN	: communication technique used in OASIS3 (MPI1/MPI2)
CHAN            = MPI1
#
# Paths for libraries, object files and binaries
#
# COUPLE	: path for oasis3-mct main directory
COUPLE          := $(OASIS_COUPLE)
#
# ARCHDIR       : directory created when compiling
ARCHDIR         := $(COUPLE)/INSTALL_OASIS.$(OASIS_ENV)
# ENABLE_YAC    : activate YAC based remapping libraries
ENABLE_YAC      = YES
#
# MPI library
#MPIDIR           = ${MPICOMPILER}
MPIDIR           = /softs/intel/oneapi/mpi/2021.10.0
MPIBIN           = $(MPIDIR)/bin
MPI_INCLUDE      = $(MPIDIR)/include
MPILIB           = -L$(MPIDIR)/lib
MPIRUN           = $(MPIBIN)/mpirun
#
# NETCDF library
NETCDF_DIR     = /softs/local_intel/netcdf/4.4.4_phdf5_1.10.4
NETCDF_LIBDIR1 = $(NETCDF_DIR)/lib
NETCDF_LIBDIR2 = /softs/local_intel/netcdf-c/4.6.1_phdf5/lib
NETCDF_INCDIR1 = $(NETCDF_DIR)/include
NETCDF_INCDIR2 = /softs/local_intel/netcdf-c/4.6.1_phdf5/include
NETCDF_LIBRARY = -Wl,-rpath,$(NETCDF_LIBDIR1) -L$(NETCDF_LIBDIR1) -Wl,-rpath,$(NETCDF_LIBDIR2) -L$(NETCDF_LIBDIR2) -lnetcdff -lnetcdf
#
# YAC compiler and options
YCC = $(MPIBIN)/mpiicc
YFC = $(MPIBIN)/mpiifort
# optimisation safe
YCFLAGS  = -O2 -fp-model precise
YFCFLAGS = -O2 -fp-model precise
# optimisation debug
#YCFLAGS  = -O0 -g -traceback
#YFCFLAGS = -O0 -g -traceback
#
# YAC libraries options for models and toys link
# Leave empty if YAC not enabled
ifeq ($(ENABLE_YAC),YES)
YAC_LIBRARY = -L$(ARCHDIR)/lib -Wl,-rpath,$(ARCHDIR)/lib \
              -lyac_utils -lyac_core -lyaxt_c
endif
#
# Compiling and other commands
MAKE        = gmake
F90         = $(MPIBIN)/mpiifort -I$(MPI_INCLUDE)
F           = $(F90)
f90         = $(F90)
f           = $(F90)
CC          = $(MPIBIN)/mpiicc -I$(MPI_INCLUDE)
LD          = $(MPIBIN)/mpiifort $(MPILIB)
# Shared libraries options
DYNOPT      = -fPIC
LDDYNOPT    = -shared
AR          = ar
ARFLAGS     = -ruv
# Fortran libraries for C linking
F2C_LIBS    = -lifcore -lifcoremt -lifport -limf
#
# CPP keys and compiler options
#
CPPDEF    = -Duse_netCDF -Duse_comm_$(CHAN) -D__VERBOSE  -DTREAT_OVERLAY
#
# -g is necessary in F90FLAGS and LDFLAGS for pgf90 versions lower than 6.1
#
FCBASEFLAGS := -I. -assume byterecl -qmkl
CCBASEFLAGS :=
ifeq ($(OASIS_DEBUG), )
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS += -O2 -xCORE-AVX2
	else
		FCBASEFLAGS += -O2 -xCORE-AVX2 -mt_mpi -qopenmp
                CCBASEFLAGS += -qopenmp
	endif
else
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS += -g -traceback -fpe0 -O0 -check all -check noarg_temp_created
        else
		FCBASEFLAGS += -g -traceback -fpe0 -O0 -check all -check noarg_temp_created -mt_mpi -qopenmp
		CCBASEFLAGS += -qopenmp
        endif
endif
#
# INC_DIR : includes all *mod for each library
INC_DIR = -I$(ARCHDIR)/include
# FLIBS : for toys when linking in local Makefile
FLIBS = $(YAC_LIBRARY) $(NETCDF_LIBRARY)
#
F90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCDIR1) -I$(NETCDF_INCDIR2)
f90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCDIR1) -I$(NETCDF_INCDIR2)
FFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCDIR1) -I$(NETCDF_INCDIR2)
fFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCDIR1) -I$(NETCDF_INCDIR2)
CCFLAGS     = $(CCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCDIR1) -I$(NETCDF_INCDIR2)
LDFLAGS     = $(FCBASEFLAGS)
F2C_LDFLAGS = $(F2C_LIBS)
#
#############################################################################
