#
# Include file for OASIS3 Makefile for Intel 21 on
# Linux computer  with OpenMP
# module load intel/21.1.1
# module load intelmpi/2021.1.1
# module load lib/netcdf-fortran/4.4.4_phdf5_1.10.4
# module load python/3.7.7
#
###############################################################################
#
# CHAN	: communication technique used in OASIS3 (MPI1/MPI2)
CHAN            = MPI1
#
# Paths for libraries, object files and binaries
#
# COUPLE	: path for oasis3-mct main directory
COUPLE          := $(OASIS_COUPLE)
#
# ARCHDIR       : directory created when compiling
ARCHDIR         := $(OASIS_BUILD_PATH)
#
# MPI library
MPIDIR           = $(I_MPI_ROOT)
MPIBIN           = $(MPIDIR)/bin
MPI_INCLUDE      = $(MPIDIR)/include
MPILIB           = -L$(MPIDIR)/lib
ifeq ($(OASIS_DEBUG), )
   MPIRUN           = $(MPIBIN)/mpirun
else
   MPIRUN           = $(MPIBIN)/mpirun -tv
endif
#
# NETCDF library
NETCDF_INCLUDE = $(NETCDF4_INCDIR)
NETCDF_LIBRARY  = -Wl,-rpath,$(NETCDF4_LIBDIR) -L$(NETCDF4_LIBDIR) -lnetcdff -lnetcdf
#
# YAC libraries
YAC_INCLUDE = -I$(YAC_ROOT)/include -I$(YAXT_ROOT)/include
YAC_LIBRARY = -L $(YAC_ROOT)/lib \
              -L $(YAXT_ROOT)/lib -Wl,-rpath,$(YAXT_ROOT)/lib \
              -lyac_utils -lyac_core -lyaxt_c
#
# Compiling and other commands
MAKE        = gmake
F90         = $(MPIBIN)/mpiifort -I$(MPI_INCLUDE)
F           = $(F90)
f90         = $(F90)
f           = $(F90)
CC          = $(MPIBIN)/mpiicc -I$(MPI_INCLUDE)
LD          = $(MPIBIN)/mpiifort $(MPILIB)
# Static libraries compilation options
ifeq ($(OASIS_DEBUG), )
        STATOPT =  -xAVX
else
        STATOPT =
endif
# Shared libraries options
DYNOPT      = -fPIC
LDDYNOPT    = -shared
AR          = ar
ARFLAGS     = -ruv
# Fortran libraries for C linking
F2C_LIBS    = -lifcore -lifcoremt -lifport -limf
#
# CPP keys and compiler options
#
CPPDEF    = -Duse_netCDF -Duse_comm_$(CHAN) -D__VERBOSE  -DTREAT_OVERLAY -DYAC_REMAP
#
# -g is necessary in F90FLAGS and LDFLAGS for pgf90 versions lower than 6.1
#
FCBASEFLAGS := -I. -assume byterecl -mkl
CCBASEFLAGS :=
ifeq ($(OASIS_DEBUG), )
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS += -O2 -xAVX
                CCBASEFLAGS += -O2
	else
		FCBASEFLAGS += -O2 -xAVX -mt_mpi -qopenmp
                CCBASEFLAGS += -O2 -qopenmp
	endif
else
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS += -g -traceback -fpe0 -O0 -check all -check noarg_temp_created
	else
		FCBASEFLAGS += -g -traceback -fpe0 -O0 -check all -check noarg_temp_created -mt_mpi -qopenmp
                CCBASEFLAGS += -qopenmp
	endif
endif
#
# INC_DIR : includes all *mod for each library
 INC_DIR = -I$(ARCHDIR)/include
# FLIBS : for toys when linking in local Makefile
 FLIBS=${YAC_LIBRARY} ${NETCDF_LIBRARY}
###################
#
F90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
f90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
FFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
fFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
CCFLAGS     = $(CCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE) $(YAC_INCLUDE)
LDFLAGS     = $(FCBASEFLAGS)
F2C_LDFLAGS = $(F2C_LIBS)
#
#############################################################################
