##############################################################################
#This is the top makefile for compiling OASIS3-MCT coupling library including
#  mct/mpeu, scrip and psmile (i.e. interpolation and communication)
#Platform dependent settings, compiler options, cpp keys, 
#paths and other stuff has to be set in an include file indicated in make.inc.
# 
# default : mct/mpeu, scrip and psmile
# oasis3_psmile (for OASIS3 upward compatibility): mct/mpeu, scrip and psmile
# realclean : Automatic recompilation of all sources
#
#######
include make.inc
#
SHELL = /bin/sh
MAKEf = $(MAKE) -f TopMakefileOasis3
#
# Defining path for FORTRAN and C sources
LIBSRC  = $(COUPLE)/lib
#
# Log and error files for compiling
LOG = $(COUPLE)/util/make_dir/COMP.log
ERR = $(COUPLE)/util/make_dir/COMP.err
# Log and error files for compiling the shared libraries
LOGDYN = $(COUPLE)/util/make_dir/COMP-shared.log
ERRDYN = $(COUPLE)/util/make_dir/COMP-shared.err
# Log and error files for compiling the C bindings
LOGBDG = $(COUPLE)/util/make_dir/COMP-c-bind.log
ERRBDG = $(COUPLE)/util/make_dir/COMP-c-bind.err
# Log and error files for installing PyOasis
LOGPYO = $(COUPLE)/util/make_dir/COMP-pyoasis.log
ERRPYO = $(COUPLE)/util/make_dir/COMP-pyoasis.err
#
#######
default: static-lib

static-and-shared-lib: static-lib shared-lib

static-lib: oasis3_psmile

oasis3_psmile:
	@rm -f $(LOG) $(ERR)
	$(MAKEf) makedirs
	$(MAKEf) makemct
	$(MAKEf) makelibs
	$(MAKEf) makepsmile

shared-lib: 
	 @rm -f $(LOGDYN) $(ERRDYN)
	 $(call check_defined, DYNOPT LDDYNOPT, shared lib. compilation options)
	 $(call check_defined, LIBBUILDDYN, shared lib. build directory)
	 $(MAKEf) makedirsdyn
	 $(MAKEf) makemctdyn
	 $(MAKEf) makelibsdyn
	 $(MAKEf) makepsmiledyn

oasis-c-bindings: shared-lib
	@rm -f $(LOGBDG) $(ERRBDG)
	$(call check_defined, LIBBUILDCBIND, C bindings lib. build directory)
	$(MAKEf) makedirscbind
	$(MAKEf) makecbindings

pyoasis: oasis-c-bindings
	@rm -f $(LOGPYO) $(ERRPYO)
	$(MAKEf) makedirspy
	$(MAKEf) makepyoasis

#
realclean:
	$(MAKEf) cleanlibs cleansharedlibs cleancbindlibs cleanpyoasis
#
# Rules for creating build and library directories
#
makedirs:
	@mkdir -p $(LIBBUILD)/scrip
	@mkdir -p $(LIBBUILD)/mctdir
	@mkdir -p $(LIBBUILD)/mct
	@mkdir -p $(LIBBUILD)/psmile.$(CHAN)
	@mkdir -p $(ARCHDIR)/include
	@mkdir -p $(ARCHDIR)/lib

makedirsdyn:
	@mkdir -p $(LIBBUILDDYN)/scrip
	@mkdir -p $(LIBBUILDDYN)/mctdir
	@mkdir -p $(LIBBUILDDYN)/mct
	@mkdir -p $(LIBBUILDDYN)/psmile.$(CHAN)
	@mkdir -p $(ARCHDIR)/include
	@mkdir -p $(ARCHDIR)/lib

makedirscbind:
	@mkdir -p $(LIBBUILDCBIND)

makedirspy:
	@mkdir -p $(ARCHDIR)/python
#
# Rules for compiling mpeu/mct library
# 
makemct:
	@echo "=> Compiling library mpeu and mct"
	@(cd $(LIBBUILD)/mctdir; cp -f -r -p $(LIBSRC)/mct/* .;\
         ./configure MPIFC="$(F90)" FC="$(F90)" CC="$(CC)" \
         1>> $(LOG) 2>> $(ERR) ;\
         $(MAKE) 1>> $(LOG) 2>> $(ERR) ; \
         cp -f ./*/lib*.a   $(ARCHDIR)/lib/; \
         cp -f ./*/*.o    $(LIBBUILD)/mct/; \
         cp -f ./*/*.mod  $(LIBBUILD)/mct/;)
#
makemctdyn:
	@echo "=> Compiling shared library mpeu and mct"
	@(cd $(LIBBUILDDYN)/mctdir; cp -f -r -p $(LIBSRC)/mct/* .;\
         ./configure MPIFC="$(F90) $(DYNOPT)" FC="$(F90) $(DYNOPT)" CC="$(CC) $(DYNOPT)" \
         1>> $(LOGDYN) 2>> $(ERRDYN) ;\
         $(MAKE) 1>> $(LOGDYN) 2>> $(ERRDYN) ; \
	 $(F90) $(DYNOPT) $(LDFLAGS) $(LDDYNOPT) \
         -o $(ARCHDIR)/lib/libmct.so ./mct/*.o $(NETCDF_LIBRARY); \
	 $(F90) $(DYNOPT) $(LDFLAGS) $(LDDYNOPT) \
         -o $(ARCHDIR)/lib/libmpeu.so ./mpeu/*.o $(NETCDF_LIBRARY); \
         cp -f ./*/*.o    $(LIBBUILDDYN)/mct/; \
         cp -f ./*/*.mod  $(LIBBUILDDYN)/mct/;)
#
# Rules for compiling the libraries scrip and psmile
#
makelibs:
	@echo "=> Compiling library scrip"
	@(cd $(LIBBUILD)/scrip; cp -f $(LIBSRC)/scrip/src/Makefile .;\
         $(modifmakefile) ; $(MAKE) all 1>> $(LOG) 2>> $(ERR) )

makelibsdyn:
	@echo "=> Compiling shared library scrip"
	@(cd $(LIBBUILDDYN)/scrip; cp -f $(LIBSRC)/scrip/src/Makefile .;\
         $(modifmakefile) ; $(MAKE) shared 1>> $(LOGDYN) 2>> $(ERRDYN) )

makepsmile:
	@echo "=> Compiling library psmile"
	@(cd $(LIBBUILD)/psmile.$(CHAN) ; \
         cp -f $(LIBSRC)/psmile/src/Makefile . ; $(modifmakefile) ; \
         $(MAKE) all 1>> $(LOG) 2>> $(ERR) ; \
	 cp -f *.mod $(ARCHDIR)/include ; )

makepsmiledyn:
	@echo "=> Compiling shared library psmile"
	@(cd $(LIBBUILDDYN)/psmile.$(CHAN) ; \
         cp -f $(LIBSRC)/psmile/src/Makefile . ; $(modifmakefile) ; \
         $(MAKE) shared 1>> $(LOGDYN) 2>> $(ERRDYN) ; \
	 cp -f *.mod $(ARCHDIR)/include ; )
#
# Rules for compiling the oasis C bindings
#
makecbindings:
	@echo "=> Compiling the C bindings"
	@(cd $(LIBBUILDCBIND) ; \
	 cp -f -r -p $(COUPLE)/pyoasis/Makefile .; $(modifmakefile) ; \
         $(MAKE) lib 1>> $(LOGBDG) 2>> $(ERRBDG) )
#
# Rules for installing the PyOasis python modules
#
makepyoasis:
	@echo "=> Installing the PyOasis Modules"
	@(cd $(LIBBUILDPYO) ; \
	 cp -f -r -p $(COUPLE)/pyoasis/Makefile .; $(modifmakefile) ; \
         $(MAKE) install 1>> $(LOGPYO) 2>> $(ERRPYO) )
	@echo export PYOASIS_ROOT=${ARCHDIR} > ${ARCHDIR}/python/init.sh
	@echo export LD_LIBRARY_PATH=\$${PYOASIS_ROOT}/lib:\$${LD_LIBRARY_PATH} >> ${ARCHDIR}/python/init.sh
	@echo export PYTHONPATH=\$${PYOASIS_ROOT}/python:\$${PYTHONPATH} >> ${ARCHDIR}/python/init.sh
	@echo export MPIRUN4PY=\"${MPIRUN}\" >> ${ARCHDIR}/python/init.sh
	@echo
	@echo =====================================================================
	@echo The following lines have been put in the file
	@echo \"${ARCHDIR}/python/init.sh\"
	@echo
	@cat ${ARCHDIR}/python/init.sh
	@echo
	@echo Before using pyOASIS issue the command:
	@echo \"source ${ARCHDIR}/python/init.sh\"
	@echo Alternatively, these lines should be added to your \"\~/.bashrc\" file. 
	@echo =====================================================================
	@echo
#
# Rules for cleaning
#
cleanlibs:
	@echo cleaning oasis3-mct libraries
	rm -f $(LIBBUILD)/scrip/*
	rm -f $(LIBBUILD)/mct/*
	rm -f -r $(LIBBUILD)/mctdir/*
	rm -f $(LIBBUILD)/psmile.$(CHAN)/*
	rm -f $(ARCHDIR)/include/*
	rm -f $(ARCHDIR)/lib/libscrip.a
	rm -f $(ARCHDIR)/lib/libmct.a
	rm -f $(ARCHDIR)/lib/libmpeu.a
	rm -f $(ARCHDIR)/lib/libpsmile.$(CHAN).a

cleansharedlibs:
	@echo cleaning oasis3-mct shared libraries
	rm -f $(LIBBUILDDYN)/scrip/*
	rm -f $(LIBBUILDDYN)/mct/*
	rm -f -r $(LIBBUILDDYN)/mctdir/*
	rm -f $(LIBBUILDDYN)/psmile.$(CHAN)/*
	rm -f $(ARCHDIR)/include/*
	rm -f $(ARCHDIR)/lib/libscrip.so
	rm -f $(ARCHDIR)/lib/libmct.so
	rm -f $(ARCHDIR)/lib/libmpeu.so
	rm -f $(ARCHDIR)/lib/libpsmile.$(CHAN).so

cleancbindlibs:
	@echo cleaning oasis3-mct C bindings libraries
	rm -f $(LIBBUILDCBIND)/*
	rm -f $(ARCHDIR)/lib/liboasis.C.bindings.so

cleanpyoasis:
	@echo cleaning pyoasis
	rm -f -r $(ARCHDIR)/python/*
#
## Some rules to modify/add variables in makefiles
#
modifmakefile =	( echo 'include $(COUPLE)/util/make_dir/make.inc' \
                         > infile; cat Makefile >> infile ; cp -f infile Makefile )
#
## Some rules to check if variables are defined
#
# Params:
#   1. Variable name(s) to test.
#   2. (optional) Error message to print.
check_defined = \
    $(strip $(foreach 1,$1, \
        $(call __check_defined,$1,$(strip $(value 2)))))
__check_defined = \
    $(if $(value $1),, \
      $(error Undefined $1$(if $2, ($2))))
#
########################################################################################
