#
# Include file for OASIS3 Makefile for kraken at Cerfacs with OpenMP
# module load compiler/intel/23.2.1
# module load mpi/intelmpi/2021.10.0
# module load lib/phdf5/1.10.4_impi
# module load lib/netcdf-fortran/4.4.4_phdf5_1.10.4
#
###############################################################################
#
# CHAN	: communication technique used in OASIS3 (MPI1/MPI2)
CHAN            = MPI1
#
# Paths for libraries, object files and binaries
#
# COUPLE	: path for oasis3-mct main directory
COUPLE          := $(OASIS_COUPLE)
#
# ARCHDIR       : directory created when compiling
ARCHDIR         := $(COUPLE)/INSTALL_OASIS.$(OASIS_ENV)
#
# MPI library
#MPIDIR           = ${MPICOMPILER}
#GJ MPIDIR           = $(I_MPI_ROOT)
MPIDIR           = /softs/intel/oneapi/mpi/2021.10.0
MPIBIN           = $(MPIDIR)/bin
MPI_INCLUDE      = $(MPIDIR)/include
MPILIB           = -L$(MPIDIR)/lib
MPIRUN           = $(MPIBIN)/mpirun
#
# NETCDF library
NETCDF_LIB_DIR1=/softs/local_intel/netcdf/4.4.4_phdf5_1.10.4/lib
#GJ NETCDF_LIB_DIR1 = $(NETCDF4_LIBDIR)
NETCDF_LIB_DIR2=/softs/local_intel/netcdf-c/4.6.1_phdf5/lib
NETCDF_INCLUDE1=/softs/local_intel/netcdf/4.4.4_phdf5_1.10.4/include
#GJ NETCDF_INCLUDE1 = $(NETCDF4_INCDIR)
NETCDF_INCLUDE2=/softs/local_intel/netcdf-c/4.6.1_phdf5/include
NETCDF_LIBRARY  =  -Wl,-rpath,/softs/local_intel/netcdf/4.4.4_phdf5_1.10.4/lib -L/softs/local_intel/netcdf/4.4.4_phdf5_1.10.4/lib -Wl,-rpath,/softs/local_intel/netcdf-c/4.6.1_phdf5/lib -L/softs/local_intel/netcdf-c/4.6.1_phdf5/lib -lnetcdff -lnetcdf
#
# YAC libraries
YAC_INCLUDE = 
YAC_LIBRARY = 
#
# Compiling and other commands
MAKE        = gmake
F90         = $(MPIBIN)/mpiifort -I$(MPI_INCLUDE)
F           = $(F90)
f90         = $(F90)
f           = $(F90)
CC          = $(MPIBIN)/mpiicc -I$(MPI_INCLUDE)
LD          = $(MPIBIN)/mpiifort $(MPILIB)
DYNOPT      = -fPIC
LDDYNOPT    = -shared
AR          = ar
ARFLAGS     = -ruv
# Fortran libraries for C linking
F2C_LIBS    = -lifcore -lifcoremt -lifport -limf
#
# CPP keys and compiler options
# 
CPPDEF    = -Duse_netCDF -Duse_comm_$(CHAN) -D__VERBOSE  -DTREAT_OVERLAY
#
# -g is necessary in F90FLAGS and LDFLAGS for pgf90 versions lower than 6.1
# 
FCBASEFLAGS := -I. -assume byterecl -qmkl
CCBASEFLAGS :=
ifeq ($(OASIS_DEBUG), )
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS += -O2 -xCORE-AVX2
	else
		FCBASEFLAGS += -O2 -xCORE-AVX2 -mt_mpi -qopenmp
                CCBASEFLAGS += -qopenmp
	endif
else
	ifeq ($(OASIS_OPENMP), )
		FCBASEFLAGS  += -g -traceback -fpe0 -check all -check noarg_temp_created
        else
		FCBASEFLAGS  += -g -traceback -fpe0 -check all -check noarg_temp_created -mt_mpi -qopenmp
		CCBASEFLAGS  += -qopenmp
        endif
endif
#
# INC_DIR : includes all *mod for each library
INC_DIR = -I$(ARCHDIR)/include
# FLIBS : for toys when linking in local Makefile
FLIBS = $(NETCDF_LIBRARY)
#
F90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE1) -I$(NETCDF_INCLUDE2)
f90FLAGS    = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE1) -I$(NETCDF_INCLUDE2)
FFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE1) -I$(NETCDF_INCLUDE2)
fFLAGS      = $(FCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE1) -I$(NETCDF_INCLUDE2)
CCFLAGS     = $(CCBASEFLAGS) $(INC_DIR) $(CPPDEF) -I$(NETCDF_INCLUDE1) -I$(NETCDF_INCLUDE2)
LDFLAGS     = $(FCBASEFLAGS)
F2C_LDFLAGS = $(F2C_LIBS)
#
#############################################################################
