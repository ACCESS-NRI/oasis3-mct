###########################################
## USER SECTION 
###########################################
# OASIS VARIABLES DEFINITION   
# + NAMES OF THE DIFFERENT TOYS
###########################################
# OASIS_ROOT
OASIS_ROOT=/data/scratch/globc/coquart
# Repository with OASIS3-MCT sources
export OASIS_COUPLE=${OASIS_ROOT}/oasis3-mct
# Variable to defined the compilation options of OASIS3-MCT and the toys
# TRUE or nothing
export OASIS_DEBUG=TRUE
# Compile oasis (nothing) or pyoasis OASIS_TARGET=pyoasis
export OASIS_TARGET=
# OASIS_ENV used to launch the environment to test on different machines 
# (see sc_launch_tests.sh)
export OASIS_ENV=intel2018.4.274_intelmpi2018.4.274_amd-scylla
# For NITROX tests: compile OASIS3-MCT and verify librairies
export OASIS_NITROX=TRUE
# Localisation and name of the toys
export USER_TOY=("${OASIS_ROOT}/oasis3-mct_tests/toy_1f1grd_to_2f2grd" \
                 "${OASIS_ROOT}/oasis3-mct_tests/toy_auxiliary_routines"\
                 "${OASIS_ROOT}/oasis3-mct_tests/toy_grids_writing")
# Number of tests for each toy		  
export USER_TEST=("4" "1" "2")
# Localization of the file paramater for each toy
export USER_PARAMLOC=("${OASIS_ROOT}/oasis3-mct_tests/toy_1f1grd_to_2f2grd" \
                      "${OASIS_ROOT}/oasis3-mct_tests/toy_auxiliary_routines" \
                      "${OASIS_ROOT}/oasis3-mct_tests/toy_grids_writing" )
