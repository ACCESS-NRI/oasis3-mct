############################################
## USER SECTION 
###########################################
# OASIS VARIABLES DEFINITION   
# + NAMES OF THE DIFFERENT TOYS
# We need at least grids.nc for each toy to calculate the analytical function
###########################################
# OASIS_ENV used to launch the environment to test on different machines 
# (see sc_launch_tests.sh)
# Variables to defined the compilation options of OASIS3-MCT and the toys
# TRUE or nothing
export OASIS_COMPILE=FALSE
# Localisation and name of the toys
export USER_TOY=("/scratch/globc/valcke/oasis3-mct_tests/toy_configuration_components_A" "/scratch/globc/valcke/oasis3-mct_tests/toy_configuration_components_B")
# Number of tests for each toy		  
export USER_TEST=("2" "1")
# Localization of the file paramater for each toy
export USER_PARAMLOC=("/scratch/globc/valcke/oasis3-mct_tests/toy_configuration_components_A" "/scratch/globc/valcke/oasis3-mct_tests/toy_configuration_components_B")
export USER_RUNDIR=/scratch/globc/valcke/OA3_MCT_RES
