spack:
  specs:
  - 'oasis3-mct@git.{{ ref }}=stable'
  - 'oasis3-mct@git.{{ ref }}=5.2'
  packages:
    intel-oneapi-compilers:
      require:
      - '@{{ oneapi_compiler_version }}'
    all:
      require:
      - '%access_oneapi'
      - 'target={{ target }}'
  concretizer:
    unify: false
  view: false
