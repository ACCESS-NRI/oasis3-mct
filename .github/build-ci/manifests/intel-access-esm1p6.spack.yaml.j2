# Building OASIS3-mct in the context of the ACCESS-ESM1.6 model
# Using the ACCESS-ESM1.6 spack.yaml from 
# https://github.com/ACCESS-NRI/ACCESS-ESM1.6/commit/79bfb39093b4305c9df76830e4a1c7a2cf039f83
spack:
  specs:
  - access-esm1p6@git.2025.07.000 cice=5
  packages:
    mom5:
      require:
        - '@git.2025.05.000=access-esm1.6'
    cice5:
      require:
        - '@git.access-esm1.6-2025.07.001=access-esm1.6'
    um7:
      require:
        - '@git.access-esm1.6-2025.06.000=access-esm1.6'
    gcom4:
      require:
        - '@git.2024.05.28=access-esm1.5'
    oasis3-mct:
      require:
        - '@git.{{ ref }}=access-esm1.5'
    openmpi:
      require:
        - '@4.1.5'
    netcdf-c:
      require:
        - '@4.9.2'
    netcdf-fortran:
      require:
        - '@4.6.1'
    hdf5:
      require:
        - '@1.14.3'
    access-fms:
      require:
        - '@git.mom5-2025.05.000=mom5'
    access-generic-tracers:
      require:
        - '@git.2025.07.001=main'
    access-mocsy:
      require:
        - '@git.2025.07.002=gtracers'
    gcc-runtime:
      require:
      - '%gcc target={{ target }}'
    all:
      require:
      - '%{{ intel_compiler }} target={{ target }}'
  concretizer:
    unify: false
  view: false
